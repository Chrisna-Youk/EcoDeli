<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.ecodeli2.DashboardController">

    <!-- Barre du haut -->
    <top>
        <ToolBar>
            <Label text="EcoDeli Dashboard" style="-fx-font-size: 16px; -fx-font-weight: bold;" styleClass="toolbar-label"/>
        </ToolBar>
    </top>

    <!-- Menu latéral -->
    <left>
        <VBox spacing="10" style="-fx-padding: 10;">
            <Button text="Home"                 onAction="#showHome"/>
            <Button text="Monthly revenue"      onAction="#showSales"/>
            <Button text="Rapports"             onAction="#showReports"/>
            <Button text="Settings"             onAction="#showSettings"/>
            <Button text="Sign out"             onAction="#onSignOutClicked"/>
        </VBox>
    </left>

    <!-- Contenu central -->
    <center>
        <StackPane fx:id="contentPane" style="-fx-padding:10;"/>
    </center>

</BorderPane>
