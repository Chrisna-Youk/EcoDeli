<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/rounded_sapin_bg"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Besoin de livrée ?"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_tournesol_green"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Titre"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Frigo"
            android:textColorHint="#B8000000"
            android:textColor="#000000"
            android:textSize="14sp"
            android:background="@drawable/edittext_tournesol_background"
            android:paddingVertical="8dp"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="12dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Type de service"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvTypeService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📦 Livraison"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/edittext_tournesol_background"
            android:paddingVertical="8dp"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="12dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description du colis"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Frigo samsung 15kg"
            android:textColorHint="#B8000000"
            android:textColor="#000000"
            android:textSize="14sp"
            android:background="@drawable/edittext_tournesol_background"
            android:paddingVertical="8dp"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="12dp"
            android:layout_marginTop="4dp"
            android:minLines="2" />

        <!-- TODO Prix calculé selon la distance (et le poids)  -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Montant de la livraison"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/etMontant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="50"
            android:textColorHint="#B8000000"
            android:inputType="numberDecimal"
            android:textColor="#000000"
            android:textSize="14sp"
            android:background="@drawable/edittext_tournesol_background"
            android:paddingVertical="8dp"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="12dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adresse de départ"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/startAdresse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="28 Rue de des Délices, 75001 Paris"
            android:textColorHint="#B8000000"
            android:textColor="#000000"
            android:textSize="14sp"
            android:background="@drawable/edittext_tournesol_background"
            android:paddingVertical="8dp"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="12dp"
            android:layout_marginTop="4dp"
            android:minLines="2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adresse de destination"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/endAdresse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Lyon"
            android:textColorHint="#B8000000"
            android:textColor="#000000"
            android:textSize="14sp"
            android:background="@drawable/edittext_tournesol_background"
            android:paddingVertical="8dp"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="12dp"
            android:layout_marginTop="4dp"
            android:minLines="2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">
            <CheckBox
                android:id="@+id/priority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Livraison prioritaire"
                android:textColor="#000000"
                android:textSize="12sp"
                android:layout_marginEnd="16dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnAnnuler"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Annuler"
                android:backgroundTint="#DD6C63"
                android:textColor="#0B0B0B"
                android:layout_marginEnd="8dp" />
            <Button
                android:id="@+id/btnCreer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Créer"
                android:backgroundTint="#DD6C63"
                android:textColor="#000000"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>